{
  "name": "automation-testing",
  "version": "3.0.0",
  "private": true,
  "description": "Playwright + TypeScript UI test framework using the Page Object Model",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:regression": "playwright test --project=chromium --grep @regression",
    "test:a11y": "playwright test --project=chromium --grep @a11y",
    "test:security": "playwright test --project=chromium --grep @security",
    "test:known-bugs": "playwright test --project=chromium --grep @known-bug",
    "test:all-browsers": "playwright test",
    "test:stability": "playwright test --project=chromium --repeat-each=5",
    "summary": "node tools/summary.js",
    "trace": "node tools/trace.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-playwright": "^2.12.2",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1"
  }
}
