{
  "info": {
    "name": "JSONPlaceholder API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "baseUrl", "value": "https://jsonplaceholder.typicode.com" }],
  "item": [
    {
      "name": "GET all posts",
      "request": { "method": "GET", "url": "{{baseUrl}}/posts" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('status 200', () => pm.response.to.have.status(200));",
        "pm.test('returns 100 posts', () => pm.expect(pm.response.json()).to.have.lengthOf(100));",
        "pm.test('response under 2000ms', () => pm.expect(pm.response.responseTime).to.be.below(2000));"
      ] } }]
    },
    {
      "name": "GET single post",
      "request": { "method": "GET", "url": "{{baseUrl}}/posts/1" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('status 200', () => pm.response.to.have.status(200));",
        "const b = pm.response.json();",
        "pm.test('has expected fields', () => pm.expect(b).to.have.all.keys('userId','id','title','body'));",
        "pm.test('id is 1', () => pm.expect(b.id).to.eql(1));"
      ] } }]
    },
    {
      "name": "GET post not found",
      "request": { "method": "GET", "url": "{{baseUrl}}/posts/9999" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('status 404', () => pm.response.to.have.status(404));"
      ] } }]
    },
    {
      "name": "GET comments by post",
      "request": { "method": "GET", "url": "{{baseUrl}}/comments?postId=1" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('status 200', () => pm.response.to.have.status(200));",
        "pm.test('all comments belong to post 1', () => pm.response.json().forEach(c => pm.expect(c.postId).to.eql(1)));",
        "pm.test('emails look valid', () => pm.response.json().forEach(c => pm.expect(c.email).to.match(/@/)));"
      ] } }]
    },
    {
      "name": "POST create post",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/posts",
        "body": { "mode": "raw", "raw": "{\"title\":\"qa test\",\"body\":\"hello\",\"userId\":1}" }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('status 201', () => pm.response.to.have.status(201));",
        "const b = pm.response.json();",
        "pm.test('echoes title', () => pm.expect(b.title).to.eql('qa test'));",
        "pm.test('has new id', () => pm.expect(b.id).to.be.a('number'));"
      ] } }]
    },
    {
      "name": "PUT update post",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/posts/1",
        "body": { "mode": "raw", "raw": "{\"id\":1,\"title\":\"updated\",\"body\":\"new\",\"userId\":1}" }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('status 200', () => pm.response.to.have.status(200));",
        "pm.test('title updated', () => pm.expect(pm.response.json().title).to.eql('updated'));"
      ] } }]
    },
    {
      "name": "DELETE post",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/posts/1" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('status 200', () => pm.response.to.have.status(200));"
      ] } }]
    }
  ]
}
